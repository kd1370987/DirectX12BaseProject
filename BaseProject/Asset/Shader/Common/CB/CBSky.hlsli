// インクルードガード
#ifndef CB_SKY_HLSLI
#define CB_SKY_HLSLI

//==========================================================================================
// スカイの設定
//
// シーンに置いた SceneAmbientObject が持っている値を、C++ 側が詰めてスカイパスへ送る。
// スカイドームのメッシュは置かず、画面の各ピクセルが見ている方向から
// 直接スカイテクスチャ(正距円筒)を引くので、ドームの形はここの2つの値で決まる。
//
//   ・horizonHeight : ドームの中心の高さ(ワールドY)。ここが地平線になる
//   ・radius        : ドームの半径
//
// カメラがこの高さから離れるほど地平線が上下に動く。半径が小さいほどその動きは強い。
// (半径を十分大きく取ると、ほぼ無限遠のスカイボックスと同じ見え方になる)
//
// ※ C++ 側 Engine::Graphics::SkyData と並びを合わせること
//==========================================================================================
struct SkyData
{
	float exposure;			// スカイの色に掛ける露出倍率
	float horizonHeight;	// 地平線の高さ(ワールドY) = 仮想ドームの中心の高さ
	float radius;			// 仮想ドームの半径
	float rotationDeg;		// 方位の回転(度)。空を回して太陽や雲の位置を合わせる

	//--------------------------------------------------------------------------------------
	// 空に被写界深度を掛けるか
	//
	// 空はメッシュを持たないので深度が far(1.0)のまま残る。距離だけで判定すると
	// 「一番遠いもの」として最大の奥ボケが掛かり、空だけがべったり滲む。
	// 既定では掛けない(isSkyDof = 0)。掛けたいときは有効にして、
	// dofScale で強さを決める(1.0 で他の遠景と同じ扱い)。
	//
	// 判定するのは CoCShader。ここは値を運ぶだけ
	//--------------------------------------------------------------------------------------
	int   isSkyDof;			// 0 なら空だけボケない
	float dofScale;			// 掛けるときのボケ量の倍率
	float2 pad;
};

// スカイ用定数バッファ
cbuffer CBSky : register(b15)
{
	SkyData g_sky;
}

#endif

// ルートシグネチャ用
#define RS_SKY_CB "CBV(b15,visibility = SHADER_VISIBILITY_ALL)"
