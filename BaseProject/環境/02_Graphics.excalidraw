   "x": 2069.9999999999995,
   "y": 1997.0,
   "width": 346.79999999999995,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "4. OptionManager を描画層の3箇所が直接読む",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. OptionManager を描画層の3箇所が直接読む",
