   "x": 1707.9999999999995,
   "y": 1877.0,
   "width": 510.2000000000001,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "3. BLAS → MainEngine は GraphicsEngine と遅延解放が欲しいだけ",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3. BLAS → MainEngine は GraphicsEngine と遅延解放が欲しいだけ",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
