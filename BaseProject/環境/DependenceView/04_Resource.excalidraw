   "x": 4079.3999999999996,
   "y": 1402.0,
   "width": 561.8000000000003,
   "height": 40.0,
   "strokeColor": "#1e1e1e",
   "text": "    ScopedResourceBuild はバッチを開くため、Mesh::Release は\n    MeshBufferAllocator へ返すため(Release には Context が来ない)。",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    ScopedResourceBuild はバッチを開くため、Mesh::Release は\n    MeshBufferAllocator へ返すため(Release には Context が来ない)。",
   "lineHeight": 1.25,
   "autoResize": true
  },
