   "x": -270.0,
   "y": 1485.0,
   "width": 1072.400000000001,
   "height": 40.0,
   "strokeColor": "#1e1e1e",
   "text": "RayEngine はシングルトンを外れ、GraphicsEngine の持ち物になった(所有の矢印は ② に載せた)。パスへは PassContext.pRayEngine で配る。\nこのシートで残る緑矢印は BLAS の遅延解放と、RenderGraph::MakeContext の入口だけ。",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RayEngine はシングルトンを外れ、GraphicsEngine の持ち物になった(所有の矢印は ② に載せた)。パスへは PassContext.pRayEngine で配る。\nこのシートで残る緑矢印は BLAS の遅延解放と、RenderGraph::MakeContext の入口だけ。",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
