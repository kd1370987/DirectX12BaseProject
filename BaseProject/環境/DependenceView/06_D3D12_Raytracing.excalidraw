   "x": 1656.3999999999994,
   "y": 1737.0,
   "width": 745.0000000000007,
   "height": 40.0,
   "strokeColor": "#1e1e1e",
   "text": "    持ち主は GraphicsEngine。RenderGraph と MainEngine の Instance() 経由の依存は消えた。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    持ち主は GraphicsEngine。RenderGraph と MainEngine の Instance() 経由の依存は消えた。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
