   "y": 1777.0,
   "width": 510.2000000000001,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "2. BLAS → MainEngine は GraphicsEngine と遅延解放が欲しいだけ",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. BLAS → MainEngine は GraphicsEngine と遅延解放が欲しいだけ",
