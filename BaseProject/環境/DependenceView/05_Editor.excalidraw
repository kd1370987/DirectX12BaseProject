   "x": 2613.999999999999,
   "y": 1682.0,
   "width": 288.99999999999994,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "2. パネルの MainEngine 直引きが残る",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. パネルの MainEngine 直引きが残る",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
