   "y": 1602.0,
   "width": 425.60000000000025,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "1. エンジン・アプリ → エディターは IDevTool 越しだけ",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. エンジン・アプリ → エディターは IDevTool 越しだけ",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "backgroundColor": "transparent",
   "seed": 13068,
   "version": 1,
   "versionNonce": 57822,
   "updated": 1,
   "link": null,
   "locked": false,
   "frameId": null,
   "groupIds": [],
   "boundElements": null,
   "roundness": null,
   "type": "text",
   "id": "i1865",
   "x": 2613.999999999999,
   "y": 1622.0,
   "width": 695.400000000001,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "text": "    MainEngine / SceneManager / Application / GameManager / InputActionManager は\n    IDevTool を見るだけで、MainEditor を名指ししない。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    MainEngine / SceneManager / Application / GameManager / InputActionManager は\n    IDevTool を見るだけで、MainEditor を名指ししない。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
