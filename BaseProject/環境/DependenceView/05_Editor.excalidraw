   "width": 899.800000000001,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "text": "MainEditor::Instance() は 0。パネルからの SceneManager / OptionManager / AudioManager の直引きも 0 になり、\nEditorContext.pServices と pEffectEditor / pEditorCamera から引く。\n残る直引きは MainEngine だけ(SceneViewPanel / ProfilerPanel / EffectEditor が各 5 回)。",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "MainEditor::Instance() は 0。パネルからの SceneManager / OptionManager / AudioManager の直引きも 0 になり、\nEditorContext.pServices と pEffectEditor / pEditorCamera から引く。\n残る直引きは MainEngine だけ(SceneViewPanel / ProfilerPanel / EffectEditor が各 5 回)。",
   "lineHeight": 1.25,
   "autoResize": true
  },
