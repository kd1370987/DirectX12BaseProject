   "y": 1992.0,
   "width": 759.6000000000007,
   "height": 80.0,
   "strokeColor": "#1e1e1e",
   "text": "    RenderGraph::MakeContext(PassContext を組む入口)、\n    ParticleBufferManager / GPUParticlePool / ParticleSimulation(遅延解放・デルタタイム)、\n    GroundFieldPass / SceneVolumetricFogPass(デルタタイム)。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    RenderGraph::MakeContext(PassContext を組む入口)、\n    ParticleBufferManager / GPUParticlePool / ParticleSimulation(遅延解放・デルタタイム)、\n    GroundFieldPass / SceneVolumetricFogPass(デルタタイム)。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
