   "width": 297.59999999999997,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "1. 描画層の残りは MainEngine の4種類",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. 描画層の残りは MainEngine の4種類",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
