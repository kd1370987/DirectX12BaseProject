   "y": 2072.0,
   "width": 401.00000000000006,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "2. パスがデルタタイムを MainEngine から引いている",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. パスがデルタタイムを MainEngine から引いている",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
