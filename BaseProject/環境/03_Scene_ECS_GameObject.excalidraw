   "y": 1802.0,
   "width": 206.39999999999992,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "3. Prefab → SceneManager",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3. Prefab → SceneManager",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
