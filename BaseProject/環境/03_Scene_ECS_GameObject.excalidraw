   "y": 1822.0,
   "width": 514.0000000000003,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "text": "    生成先のワールドを SceneManager::RefWorld() で決めている。\n    引数で World を受け取れば片付く。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    生成先のワールドを SceneManager::RefWorld() で決めている。\n    引数で World を受け取れば片付く。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
