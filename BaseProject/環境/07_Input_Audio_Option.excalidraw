   "x": 2346.8999999999996,
   "y": 1527.0,
   "width": 450.19999999999993,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "1. OptionManager と各マネージャーが相互に引き合っている",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. OptionManager と各マネージャーが相互に引き合っている",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "backgroundColor": "transparent",
   "seed": 14279,
   "version": 1,
   "versionNonce": 63185,
   "updated": 1,
   "link": null,
   "locked": false,
   "frameId": null,
   "groupIds": [],
   "boundElements": null,
   "roundness": null,
   "type": "text",
   "id": "i2038",
   "x": 2346.8999999999996,
   "y": 1547.0,
   "width": 526.2,
   "height": 80.0,
   "strokeColor": "#1e1e1e",
   "text": "    WindowOption → MainEngine / AudioOption → AudioManager /\n    InputOption → InputManager。Option 側から押し込むのをやめ、\n    受け手が起動時と変更通知で読む形にすると片方向になる。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    WindowOption → MainEngine / AudioOption → AudioManager /\n    InputOption → InputManager。Option 側から押し込むのをやめ、\n    受け手が起動時と変更通知で読む形にすると片方向になる。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "backgroundColor": "transparent",
   "seed": 14286,
   "version": 1,
   "versionNonce": 63216,
   "updated": 1,
   "link": null,
   "locked": false,
   "frameId": null,
   "groupIds": [],
   "boundElements": null,
   "roundness": null,
   "type": "text",
   "id": "i2039",
   "x": 2346.8999999999996,
   "y": 1627.0,
   "width": 361.8,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "2. 所有されている側が親を引いている箇所が残る",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. 所有されている側が親を引いている箇所が残る",
