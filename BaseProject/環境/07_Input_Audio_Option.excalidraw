   "width": 385.0,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "4. GameManager がゲーム側の各所から引かれている",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. GameManager がゲーム側の各所から引かれている",
