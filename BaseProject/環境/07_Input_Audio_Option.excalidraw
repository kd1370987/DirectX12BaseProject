   "x": 2398.999999999999,
   "y": 1432.0,
   "width": 397.0,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "3. InputActionManager → MainEditor はモード判定",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3. InputActionManager → MainEditor はモード判定",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "backgroundColor": "transparent",
   "seed": 14475,
   "version": 1,
   "versionNonce": 64053,
   "updated": 1,
   "link": null,
   "locked": false,
   "frameId": null,
   "groupIds": [],
