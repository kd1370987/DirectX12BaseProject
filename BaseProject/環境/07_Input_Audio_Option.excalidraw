   "x": 2398.999999999999,
   "y": 1452.0,
   "width": 450.4,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "text": "    アプリのモードを持っているのは MainEngine。\n    そちらから取ればゲーム側がエディターを見なくて済む。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    アプリのモードを持っているのは MainEngine。\n    そちらから取ればゲーム側がエディターを見なくて済む。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
