   "width": 252.2,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "4. 実体と IO が相互に絡んでいる",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. 実体と IO が相互に絡んでいる",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
