   "x": 2135.3999999999996,
   "y": 1802.0,
   "width": 296.4,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "3. BaseScene だけが例外で9個を直引き",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3. BaseScene だけが例外で9個を直引き",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "backgroundColor": "transparent",
