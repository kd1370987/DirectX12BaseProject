   "y": 1942.0,
   "width": 296.19999999999993,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "5. Prefab / CollisionWorld の直引き",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "5. Prefab / CollisionWorld の直引き",
