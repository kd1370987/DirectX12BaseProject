   "y": 1882.0,
   "width": 557.4000000000001,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "text": "    World.h / ComponentMetaRegistry → MainEditor はログ目的。\n    ログ用の細いインターフェースを挟めば ECS からエディターが消える。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    World.h / ComponentMetaRegistry → MainEditor はログ目的。\n    ログ用の細いインターフェースを挟めば ECS からエディターが消える。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
