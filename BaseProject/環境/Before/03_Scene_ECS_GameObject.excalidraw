   "x": 2135.3999999999996,
   "y": 1862.0,
   "width": 236.2,
   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "4. ECS がエディターを見ている",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. ECS がエディターを見ている",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
