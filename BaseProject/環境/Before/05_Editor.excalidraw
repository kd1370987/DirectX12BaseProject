   "type": "text",
   "id": "i1929",
   "x": 2837.199999999999,
   "y": 1612.0,
   "width": 662.200000000001,
   "height": 100.0,
   "strokeColor": "#1e1e1e",
   "text": "    AssetDatabase / Archive / PipelineState / World / ComponentMetaRegistry /\n    CollisionWorld / BVHTraverser が MainEditor を直引き。\n    用途はログ・計測・デバッグ描画なので、そこだけ細いインターフェースを\n    切って挟めば、エンジンがエディターを知らなくて済む。\n",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "    AssetDatabase / Archive / PipelineState / World / ComponentMetaRegistry /\n    CollisionWorld / BVHTraverser が MainEditor を直引き。\n    用途はログ・計測・デバッグ描画なので、そこだけ細いインターフェースを\n    切って挟めば、エンジンがエディターを知らなくて済む。\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
