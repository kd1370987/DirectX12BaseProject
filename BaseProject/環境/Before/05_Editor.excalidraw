   "strokeColor": "#1e1e1e",
   "text": "SceneViewPanel と EffectEditor がいちばん多くのシングルトンを直接引いている。",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SceneViewPanel と EffectEditor がいちばん多くのシングルトンを直接引いている。",
