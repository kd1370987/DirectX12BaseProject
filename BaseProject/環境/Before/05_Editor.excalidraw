   "height": 20.0,
   "strokeColor": "#e8590c",
   "text": "3. エンジン側からエディターへの逆向き依存",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "3. エンジン側からエディターへの逆向き依存",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
