   "height": 40.0,
   "strokeColor": "#1e1e1e",
   "text": "シングルトンは 13 個。実体を持つのは MainEngine / SceneManager / GameManager で、\n残りは「どこからでも引ける置き場」として使われている。",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "シングルトンは 13 個。実体を持つのは MainEngine / SceneManager / GameManager で、\n残りは「どこからでも引ける置き場」として使われている。",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
